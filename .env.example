# ==========================================
# Frontend Public Environment Variables (Vite)
# ==========================================

# Groq AI API Key for Journey Concierge Chatbot (from https://console.groq.com/keys)
VITE_GROQ_API_KEY=gsk_your_groq_api_key_here

# Contact Email Displayed on Website
VITE_CONTACT_EMAIL=contact@zentrevo.in

# ==========================================
# Backend SMTP Serverless Configuration (Vercel)
# ==========================================

# GoDaddy / Titan SMTP Settings:
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contact@zentrevo.in
SMTP_PASS=your_email_password_here

# Where traveler booking dossiers are alerted (comma-separated):
NOTIFICATION_EMAIL=contact@zentrevo.in,vibhudixit88@gmail.com
